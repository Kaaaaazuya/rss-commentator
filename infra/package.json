{
	"name": "cdk",
	"version": "0.1.0",
	"bin": {
		"cdk": "bin/cdk.js"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"test": "jest",
		"cdk": "cdk",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"bootstrap": "cdk bootstrap",
		"synth": "cdk synth",
		"diff": "cdk diff",
		"deploy": "cdk deploy --all --require-approval never",
		"deploy:hotswap": "cdk deploy --all --hotswap --require-approval never",
		"deploy:with-approval": "cdk deploy --all",
		"destroy": "cdk destroy --all"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "22.16.4",
		"aws-cdk": "2.1020.2",
		"eslint": "^9.24.0",
		"eslint-cdk-plugin": "^2.2.0",
		"jest": "^29.7.0",
		"jest-snapshot-serializer-raw": "^2.0.0",
		"ts-jest": "^29.2.6",
		"ts-node": "^10.9.2",
		"typescript": "~5.8.0",
		"typescript-eslint": "^8.29.0"
	},
	"dependencies": {
		"@typescript-eslint/parser": "^8.29.0",
		"aws-cdk-lib": "^2.171.1",
		"constructs": "^10.0.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-cdk": "^1.8.0"
	}
}
